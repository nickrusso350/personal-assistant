<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nickrusso.dailydigest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
		<string>/Users/__USER__/Documents/Claude/personal_assistant/deliver.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/__USER__/Documents/Claude/personal_assistant</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/__USER__/Library/Logs/personal_assistant/digest.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/__USER__/Library/Logs/personal_assistant/digest.err</string>
</dict>
</plist>
